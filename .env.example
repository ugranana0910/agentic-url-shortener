DB_URL=jdbc:postgresql://localhost:5432/agentic_url_shortener
DB_USERNAME=postgres
DB_PASSWORD=postgres

SERVER_PORT=8080
SHORT_URL_BASE_URL=http://localhost:8080

IDEMPOTENCY_RETENTION=PT24H
IDEMPOTENCY_IN_PROGRESS_TIMEOUT=PT2M
IDEMPOTENCY_MAX_KEY_LENGTH=128

MODEL_PROVIDER=deterministic

AGENT_WORKSPACE_ROOT=./agent-workspaces
AGENT_REPOSITORY_ROOT=.
AGENT_REPOSITORY_MAX_FILES=2000
AGENT_REPOSITORY_MAX_FILE_SIZE_BYTES=1048576

AGENT_MAX_ATTEMPTS=2
AGENT_COMMAND_TIMEOUT_SECONDS=120
AGENT_MAX_OUTPUT_CHARACTERS=100000